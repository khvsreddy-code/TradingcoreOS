{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    },
    "api/queue.ts": {
      "maxDuration": 240,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tradingcore-background"
        }
      ]
    }
  }
}
