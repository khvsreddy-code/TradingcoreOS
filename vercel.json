{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/api/realtime/ws",
      "destination": {
        "service": "realtime"
      }
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    },
    "api/queue.ts": {
      "maxDuration": 240,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tradingcore-background"
        }
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "fluid": true,
  "services": {
    "realtime": {
      "root": ".",
      "entrypoint": "Dockerfile.realtime.vercel",
      "runtime": "container"
    }
  }
}
