{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "functions": {
        "api/index.ts": {
          "maxDuration": 15
        },
        "api/queue.ts": {
          "maxDuration": 240,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "tradingcore-background"
            }
          ]
        }
      }
    },
    "realtime-v2": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "runtime": "container",
      "ignoreCommand": "node tools/ignore-realtime-build.mjs"
    }
  },
  "regions": [
    "bom1"
  ],
  "rewrites": [
    {
      "source": "/api/realtime/healthz",
      "destination": {
        "service": "realtime-v2"
      }
    },
    {
      "source": "/api/realtime/ws",
      "destination": {
        "service": "realtime-v2"
      }
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
