# Browser Supabase config (publishable key only)
VITE_SUPABASE_URL=https://atoxvshsefhouadmunos.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Supabase config
SUPABASE_URL=https://atoxvshsefhouadmunos.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Older projects may instead expose SUPABASE_SERVICE_ROLE_KEY. Use exactly one server-side secret key.

# FYERS API plan entitlements — server-side only.
# Default is Standard. Only add a user ID after verifying that user's active FYERS Prime plan.
# Example: FYERS_API_PLAN_BY_USER={"tradingcore-user-uuid":"prime"}
# Never accept a plan from a browser query/body/header.
FYERS_API_PLAN_BY_USER={}

# FYERS post-April-2026 fixed-IP order execution
FYERS_EXECUTION_GATEWAY_URL=https://your-fixed-ip-gateway.example.com
FYERS_EXECUTION_GATEWAY_SECRET=replace-with-a-long-random-secret

# Hosted Python production ML service
ML_SERVICE_URL=https://your-ml-service.example.com
ML_SERVICE_SECRET=replace-with-a-long-random-secret

# Optional isolated shared broker coordination backend. These credentials are server-only
# except the publishable key, which grants no access without the shared secret. Keep the
# shared secret at least 32 characters; never use a VITE_ prefix for it.
TCO_BROKER_COORDINATION_SUPABASE_URL=
TCO_BROKER_COORDINATION_SUPABASE_KEY=
TCO_BROKER_COORDINATION_SHARED_SECRET=

# Shared serverless coordination (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-standard-server-token
TRADINGCORE_DISTRIBUTED_COORDINATION=true
# Required in production. Readiness and FYERS REST admission fail closed if Redis is missing or unreachable.
TRADINGCORE_DISTRIBUTED_COORDINATION_REQUIRED=true

# Dedicated realtime gateway (separate long-lived service)
REALTIME_GATEWAY_URL=https://realtime.example.com
REALTIME_GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret
REALTIME_REDIS_REST_URL=https://your-db.upstash.io
REALTIME_REDIS_REST_TOKEN=replace-with-the-same-standard-server-token
REALTIME_GATEWAY_PORT=8080

# CoreSpirit Copilot — server-side only; never expose this key as a VITE_ variable
GEMINI_API_KEY=replace-with-a-server-side-google-ai-api-key
CORESPIRIT_COPILOT_MODEL=gemini-3.8-flash

# External automation gateway: HMAC secret for trusted server-side CoreSpirit realtime signal ingress.
# Keep server-side only; never use a VITE_ prefix or expose it in browser code.
TCO_CORESPIRIT_SIGNAL_SECRET=replace-with-a-random-secret-at-least-32-characters

# Server-only historical OHLCV fallback service (never add VITE_ to these values).
# The Python tvdatafeed service must be network-restricted and bearer-token protected.
TVDATAFEED_SERVICE_URL=
TVDATAFEED_SERVICE_TOKEN=
# Optional authenticated TradingView credentials, configured only in the Python service.
TVDATAFEED_USERNAME=
TVDATAFEED_PASSWORD=
# Optional exact-FYERS-symbol map. Each value requires an explicit tvSymbol and tvExchange.
# Example: {"NSE:NIFTY50-INDEX":{"instrumentId":"NSE:NIFTY50-INDEX","fyersSymbol":"NSE:NIFTY50-INDEX","tvSymbol":"NIFTY","tvExchange":"NSE","exchange":"NSE","instrumentType":"index","timezone":"Asia/Kolkata","sessionOpen":"09:15","sessionClose":"15:30","adjustmentPolicy":"none","calendarComplete":false}}
TVDATAFEED_SYMBOL_MAP={}
