# Browser Supabase config (publishable key only)
VITE_SUPABASE_URL=https://atoxvshsefhouadmunos.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Supabase config
SUPABASE_URL=https://atoxvshsefhouadmunos.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Older projects may instead expose SUPABASE_SERVICE_ROLE_KEY. Use exactly one server-side secret key.

# FYERS post-April-2026 fixed-IP order execution
FYERS_EXECUTION_GATEWAY_URL=https://your-fixed-ip-gateway.example.com
FYERS_EXECUTION_GATEWAY_SECRET=replace-with-a-long-random-secret

# Hosted Python production ML service
ML_SERVICE_URL=https://your-ml-service.example.com
ML_SERVICE_SECRET=replace-with-a-long-random-secret

# Shared serverless coordination (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-standard-server-token
TRADINGCORE_DISTRIBUTED_COORDINATION=true
TRADINGCORE_DISTRIBUTED_COORDINATION_REQUIRED=false

# Dedicated realtime gateway (separate long-lived service)
REALTIME_GATEWAY_URL=https://realtime.example.com
REALTIME_GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret
REALTIME_REDIS_REST_URL=https://your-db.upstash.io
REALTIME_REDIS_REST_TOKEN=replace-with-the-same-standard-server-token
REALTIME_GATEWAY_PORT=8080
