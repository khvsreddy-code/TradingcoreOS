{
  "name": "tradingcoreos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run bundle:budget",
    "start": "vite preview",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "architecture:check": "npm run test:contracts",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node tools/run-contracts.mjs",
    "coreSpirit:check": "node tools/corespirit-cli.mjs check",
    "coreSpirit:normalize": "node tools/corespirit-cli.mjs normalize",
    "coreSpirit:inspect": "node tools/corespirit-cli.mjs inspect",
    "coreSpirit:graph": "node tools/corespirit-cli.mjs graph",
    "ci": "npm run test:contracts && npm run typecheck && npm run build",
    "verify:browser": "node tools/verify-chart-performance.mjs",
    "build:corespirit:wasm": "sh tools/build-core-spirit-wasm.sh",
    "benchmark:corespirit:wasm": "tsx tools/benchmark-core-spirit-wasm.mjs",
    "realtime:gateway": "tsx realtime-gateway/server.ts",
    "latency:contracts": "node src/realtimeArchitectureContract.test.mjs",
    "bundle:budget": "node tools/check-bundle-budget.mjs",
    "bundle:report": "TCO_MAX_INITIAL_GZIP_KB=100000 TCO_MAX_LANDING_GZIP_KB=100000 TCO_MAX_LOGIN_GZIP_KB=100000 TCO_MAX_WORKSPACE_GZIP_KB=100000 TCO_MAX_CHART_GZIP_KB=100000 TCO_MAX_LIVE_GZIP_KB=100000 TCO_MAX_CORESPIRIT_EDITOR_GZIP_KB=100000 TCO_MAX_MODELS_GZIP_KB=100000 TCO_MAX_PREDICTIONS_GZIP_KB=100000 TCO_MAX_AUTOMATIONS_GZIP_KB=100000 TCO_MAX_INDICATORS_GZIP_KB=100000 node tools/check-bundle-budget.mjs",
    "verify:browser:auth": "node tools/verify-authenticated-chart-performance.mjs",
    "verify:browser:matrix": "node tools/verify-chart-matrix.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "@zag-js/core": "^1.42.0",
    "@zag-js/dialog": "^1.42.0",
    "@zag-js/dom-query": "^1.42.0",
    "@zag-js/menu": "^1.42.0",
    "@zag-js/tooltip": "^1.42.0",
    "@zag-js/types": "^1.42.0",
    "@zag-js/vanilla": "^1.42.0",
    "@vercel/queue": "^0.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "esbuild": "^0.25.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "engines": {
    "node": "24.x"
  }
}
