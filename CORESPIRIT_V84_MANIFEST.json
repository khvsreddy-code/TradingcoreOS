{
  "release": "CoreSpirit v84 — route, terminal, and boundary-contract hardening",
  "baseline": "v83",
  "roadmap_range": "1–59",
  "kind": "architecture_consolidation_hardening",
  "terminal": {
    "canonical": "src/LiveTradingTerminal.tsx",
    "controller": "src/components/workspace/hooks/useLiveTradingTerminalController.ts",
    "retired_generations": [
      "LiveTradingTerminalV2.tsx",
      "LiveTradingTerminalV3.tsx",
      "LiveTradingTerminalV4.tsx",
      "LiveTradingTerminalV5.tsx"
    ],
    "guard": "src/architectureConsolidationGuard.test.mjs"
  },
  "routing": {
    "spa_fallback": "/(.*) → /",
    "api": "/api/:path* → /api/index",
    "canonical_workspace_route_registry": "src/routing/appRoutes.ts",
    "corespirit_route": "/corespirit"
  },
  "boundary_typing": {
    "runtime_events": "typed RuntimeEventPayloads",
    "broker_api": "dependency-free runtime payload guards",
    "validated_boundaries": [
      "broker JSON envelopes",
      "profile",
      "funds",
      "holdings",
      "positions",
      "orders",
      "trades",
      "market quotes",
      "historical candles",
      "option chain",
      "order payload",
      "CoreSpirit worker result outputs"
    ]
  },
  "invariants": [
    "one canonical live terminal implementation",
    "no source-mutating hotfix workflow",
    "API routes are separated from SPA fallback",
    "CoreSpirit route is part of canonical workspace route registry",
    "external JSON is validated before crossing into typed internal models",
    "runtime event payloads have explicit types"
  ],
  "verification": [
    "STAGE88_TERMINAL_ARCHITECTURE_GUARD_OK",
    "STAGE89_SPA_ROUTE_CONTRACT_OK",
    "STAGE90_BOUNDARY_VALIDATION_OK",
    "STAGE91_CORESPIRIT_WORKER_BOUNDARY_OK"
  ]
}
